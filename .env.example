# ComfyUI Setup Environment Configurations

# Civitai API Key / Token
CIVITAI_TOKEN="your_civitai_api_token_here"

# Custom User-Agent header for HTTP requests
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"

# Download Retries and Timeouts
MAX_RETRIES=5
TIMEOUT=60

# Minimum Disk Space Requirement (GB)
REQUIRED_SPACE_GB=10

# Disable SSL Verification (0 = strict SSL check, 1 = skip SSL check)
DISABLE_SSL_VERIFY=0

# Mirror Manifest Source URL for daily cron updates
MIRROR_MANIFEST_URL="https://raw.githubusercontent.com/hung187/comfyui-setup1/main/config/models_backup_list.csv"
